NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5173
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Cloudflare Turnstile protects Magic Link requests.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET=your-server-only-turnstile-secret
# Production must list only production frontend hostnames.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Server-only Supabase key. Use the secret key (sb_secret_...) or legacy service role key.
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# Optional macOS local-development fallback. Production should use SUPABASE_SECRET_KEY.
# SUPABASE_SECRET_KEYCHAIN_ACCOUNT=science-studio
# SUPABASE_SECRET_KEYCHAIN_SERVICE=science-studio-supabase-secret-key

# Waffo Pancake server-only test checkout configuration.
WAFFO_MERCHANT_ID=MER_your-merchant-id
WAFFO_STORE_ID=STO_your-store-id
WAFFO_ENVIRONMENT=test
WAFFO_MIDDLE_SCHOOL_PACK_PRODUCT_ID=PROD_your-product-id
# Local development may point to a file outside the repository.
WAFFO_PRIVATE_KEY_FILE=/absolute/path/to/waffo-private-key.pem
# CI/deployment alternative: base64 of the complete PEM text.
# WAFFO_PRIVATE_KEY_BASE64=base64-encoded-pem
